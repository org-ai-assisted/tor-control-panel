set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "$0: START"

## TODO: Rewrite this so that it:
## * Creates a FIFO under /run/tor-control-panel, with a mode of 0700
## * Chowns it to the calling user
## * Reads from it, the client side will then write to it the Tor config file
##   contents
## * Plops the contents that are read into the Tor config file
##
## This will require adding a feature to privleap to allow programs run by
## actions to tell what user triggered them.

tcp_comm_dir='/run/tor-control-panel'
tcp_comm_fifo="${tcp_comm_dir}/tcp-write-torrc.fifo"
local_torrc_d='/usr/local/etc/torrc.d'
torrc_file_path="${local_torrc_d}/40_tor_control_panel.conf"
fifo_client_uid="${PRIVLEAP_CALLER_UID:-}"

if [ -z "${fifo_client_uid}" ]; then
  printf '%s\n' "$0: ERROR: Cannot get client UID!"
  exit 1
fi
mkdir --parents -- "${tcp_comm_dir}" || exit 1
safe-rm --force -- "${tcp_comm_fifo}" || exit 1
mkfifo --mode=0600 -- "${tcp_comm_fifo}" || exit 1
chown -- "${fifo_client_uid}:root" "${tcp_comm_fifo}" || exit 1

mkdir --parents --verbose -- "${local_torrc_d}"

tor_conf_contents="$(cat -- "${tcp_comm_fifo}")"

## Sanity test.
if [ "${tor_conf_contents}" = "" ]; then
  echo "$0: ERROR: No Tor configuration provided by client!" >&2
  exit 1
fi

printf '%s\n' "${tor_conf_contents}" | tee -- "${torrc_file_path}" >/dev/null

safe-rm -- "${tcp_comm_fifo}"

## Default ownership may be too restrictive.
chmod --verbose 644 -- "${torrc_file_path}"

true "$0: END"
